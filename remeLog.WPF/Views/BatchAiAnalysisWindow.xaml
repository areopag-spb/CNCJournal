<Window x:Class="remeLog.Views.BatchAiAnalysisWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:remeLog.ViewModels"
        xmlns:controls="clr-namespace:remeLog.Views.Controls"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow" WindowState="Maximized" ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance Type=vm:BatchAiAnalysisViewModel}"
        Title="Пакетный ИИ-анализ суток" Height="600" Width="900"
        Background="{DynamicResource Areopag.Bg0}">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" HorizontalContentAlignment="Stretch">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0 -1"/>
            </StatusBarItem>
        </StatusBar>
        <ProgressBar DockPanel.Dock="Bottom"
                     Height="3"
                     Minimum="0" Maximum="1"
                     Value="{Binding OverallProgress, Mode=OneWay}"/>

        <DockPanel DockPanel.Dock="Top" Margin="6">
            <Button DockPanel.Dock="Right"
                    Content="Запустить"
                    Width="110" Margin="6 0 0 0"
                    FontSize="14"
                    Command="{Binding StartCommand}"
                    Style="{StaticResource Areopag.PrimaryButton}" FontFamily="{DynamicResource Areopag.FontMono}"/>
            <Button DockPanel.Dock="Right"
                    Content="Остановить"
                    Width="110" Margin="6 0 0 0"
                    FontSize="14"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource Areopag.DangerButton}" FontFamily="{DynamicResource Areopag.FontMono}"/>
            <Button DockPanel.Dock="Right"
                     Content="Обновить список"
                     Width="150" Margin="6 0 0 0"
                     FontSize="14"
                     Command="{Binding RefreshCommand}"/>
            <!-- Селекторы: режим и его параметры. Доступны, пока нет запуска -->
            <WrapPanel DockPanel.Dock="Left" VerticalAlignment="Center" IsEnabled="{Binding IsIdle}">
                <StackPanel Margin="0 0 12 0">
                    <TextBlock Text="Режим" FontSize="11" Foreground="{DynamicResource Areopag.Text3}"/>
                    <ComboBox MinWidth="170" FontSize="14"
                              ItemsSource="{Binding ModeOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding Mode}"/>
                </StackPanel>
                <StackPanel Margin="0 0 12 0"
                            Visibility="{Binding AutoCloseEmpty, Converter={StaticResource InvertedVisibilityConverter}}">
                    <TextBlock Text="Что брать" FontSize="11" Foreground="{DynamicResource Areopag.Text3}"/>
                    <ComboBox MinWidth="190" FontSize="14"
                              ItemsSource="{Binding AnalysisScopeOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding OnlyPending}"/>
                </StackPanel>
                <StackPanel Margin="0 0 12 0"
                            Visibility="{Binding AutoCloseEmpty, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="Какие сутки" FontSize="11" Foreground="{DynamicResource Areopag.Text3}"/>
                    <ComboBox MinWidth="210" FontSize="14"
                              ItemsSource="{Binding ScopeOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding Scope}"/>
                </StackPanel>
                <StackPanel Margin="0 0 12 0"
                            Visibility="{Binding AutoCloseEmpty, Converter={StaticResource VisibilityConverter}}">
                    <TextBlock Text="Запись" FontSize="11" Foreground="{DynamicResource Areopag.Text3}"/>
                    <ComboBox MinWidth="130" FontSize="14"
                              ItemsSource="{Binding WriteModeOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding AutoCloseDryRun}"/>
                </StackPanel>
                <StackPanel Margin="0 0 12 0">
                    <TextBlock Text="ИИ" FontSize="11" Foreground="{DynamicResource Areopag.Text3}"/>
                    <ComboBox MinWidth="110" FontSize="14"
                              ItemsSource="{Binding AiModeOptions}"
                              DisplayMemberPath="Name" SelectedValuePath="Value"
                              SelectedValue="{Binding ThinkingEnabled}"/>
                </StackPanel>
            </WrapPanel>
            <TextBlock VerticalAlignment="Center" FontSize="14">
                <Run Text="Обработано:"/>
                <Run Text="{Binding ProcessedCount, Mode=OneWay}"/>
                <Run Text="/"/>
                <Run Text="{Binding TotalCount, Mode=OneWay}"/>
            </TextBlock>
        </DockPanel>

        <!-- Период для режима автозакрытия: какие сутки искать -->
        <DockPanel DockPanel.Dock="Top" Margin="6 0 6 6"
                   Visibility="{Binding AutoCloseEmpty, Converter={StaticResource VisibilityConverter}}">
            <TextBlock DockPanel.Dock="Left" Text="С:" VerticalAlignment="Center"
                       FontSize="14" Margin="0 0 4 0"
                       FontFamily="{DynamicResource Areopag.FontMono}"
                       Foreground="{DynamicResource Areopag.Text}"/>
            <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding FromDate}" Width="130"
                        FontFamily="{DynamicResource Areopag.FontMono}" FontSize="14" Margin="0 0 12 0"
                        BorderThickness="0" Style="{StaticResource DatePickerOutlineStyle}"
                        CalendarStyle="{StaticResource Areopag.CalendarStyle}"/>
            <TextBlock DockPanel.Dock="Left" Text="По:" VerticalAlignment="Center"
                       FontSize="14" Margin="0 0 4 0"
                       FontFamily="{DynamicResource Areopag.FontMono}"
                       Foreground="{DynamicResource Areopag.Text}"/>
            <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding ToDate}" Width="130"
                        FontFamily="{DynamicResource Areopag.FontMono}" FontSize="14" Margin="0 0 12 0"
                        BorderThickness="0" Style="{StaticResource DatePickerOutlineStyle}"
                        CalendarStyle="{StaticResource Areopag.CalendarStyle}"/>
            <!-- Фильтр по станкам — общий контрол, как в календаре проверки -->
            <controls:MachineFilterSelector DockPanel.Dock="Left" VerticalAlignment="Center"
                                            Margin="0 0 12 0" Width="184"
                                            ItemsSource="{Binding MachineFilters}"
                                            Summary="{Binding MachineFilterSummary}"
                                            ShowAllCommand="{Binding ShowAllMachinesCommand}"
                                            HideAllCommand="{Binding HideAllMachinesCommand}"
                                            InvertCommand="{Binding InvertMachinesCommand}"/>
            <Button DockPanel.Dock="Left" Content="История" Width="110" Margin="0 0 12 0"
                    FontSize="14" VerticalAlignment="Center"
                    Command="{Binding ShowAutoCloseHistoryCommand}"
                    ToolTip="Кто и когда пакетно закрывал сутки"/>
            <Button DockPanel.Dock="Left" Content="Сводка" Width="110" Margin="0 0 12 0"
                    FontSize="14" VerticalAlignment="Center"
                    Command="{Binding ShowAutoCloseSummaryCommand}"
                    ToolTip="Что ИИ закрыл, что оставил человеку и почему; выборочный контроль закрытых суток"/>
            <!-- Принцип отбора кандидатов под выбранные режим и охват -->
            <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Areopag.Text2}"
                       Text="{Binding ModeHint}"/>
        </DockPanel>

        <!-- Пояснение режима анализа (период и станки нужны только автозакрытию) -->
        <TextBlock DockPanel.Dock="Top" Margin="6 0 6 6" FontSize="12" TextWrapping="Wrap"
                   Foreground="{DynamicResource Areopag.Text2}"
                   Text="{Binding ModeHint}"
                   Visibility="{Binding AutoCloseEmpty, Converter={StaticResource InvertedVisibilityConverter}}"/>

        <ListView ItemsSource="{Binding Items}"
                  FontSize="14"
                  BorderThickness="0 1 0 0"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  VirtualizingPanel.IsVirtualizing="True"
                  VirtualizingPanel.VirtualizationMode="Recycling">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Padding" Value="2"/>
                    <Setter Property="BorderBrush" Value="{DynamicResource Areopag.LineSoft}"/>
                    <Setter Property="BorderThickness" Value="0 0 0 1"/>
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Expander IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                        <Expander.Header>
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10"
                                         Margin="0 0 6 0"
                                         Fill="{Binding StateBrush}"/>
                                <TextBlock Text="{Binding Header}"
                                           FontWeight="SemiBold"/>
                            </StackPanel>
                        </Expander.Header>
                        <Grid Margin="12 4 4 4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="2"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Grid.Resources>
                                <Style TargetType="TextBlock">
                                    <Setter Property="TextWrapping" Value="Wrap"/>
                                    <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
                                </Style>
                            </Grid.Resources>
                            <DockPanel Grid.Column="0" Margin="0 0 4 0">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Размышления ИИ"
                                           FontSize="11" Foreground="{DynamicResource Areopag.Text3}"
                                           Margin="0 0 0 2"/>
                                <ScrollViewer MaxHeight="160"
                                              VerticalScrollBarVisibility="Auto">
                                    <TextBlock Text="{Binding ThinkingThoughts}"
                                               FontSize="11" FontFamily="{StaticResource Areopag.FontMono}"
                                               TextWrapping="Wrap"/>
                                </ScrollViewer>
                            </DockPanel>
                            <Border Grid.Column="1" Background="{DynamicResource Areopag.LineSoft}" Width="1"/>
                            <DockPanel Grid.Column="2" Margin="4 0 0 0">
                                <TextBlock DockPanel.Dock="Top"
                                           Text="Объяснение по данным"
                                           FontSize="11" Foreground="{DynamicResource Areopag.Text3}"
                                           Margin="0 0 0 2"/>
                                <ScrollViewer MaxHeight="160"
                                              VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock Text="{Binding Explanation}"
                                                   FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ShiftReportNote}"
                                                   FontSize="12" TextWrapping="Wrap" Margin="0 4 0 0"
                                                   Visibility="{Binding HasShiftReportNote, Converter={StaticResource VisibilityConverter}}">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                    <Setter Property="Foreground" Value="{DynamicResource Areopag.Text3}"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ShiftCausedEscalation}" Value="True">
                                                            <Setter Property="Foreground" Value="{DynamicResource Areopag.Warn}"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </StackPanel>
                                </ScrollViewer>
                            </DockPanel>
                        </Grid>
                    </Expander>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </DockPanel>
</Window>
