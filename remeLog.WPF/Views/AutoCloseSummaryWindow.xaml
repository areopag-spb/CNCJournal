<Window x:Class="remeLog.Views.AutoCloseSummaryWindow" chrome:WindowChromeTheme.Enabled="True"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:remeLog.ViewModels"
        mc:Ignorable="d" WindowStartupLocation="CenterOwner"
        WindowStyle="SingleBorderWindow" ResizeMode="CanResize"
        d:DataContext="{d:DesignInstance Type=vm:AutoCloseSummaryViewModel}"
        Title="Сводка автозакрытия" Height="720" Width="1120"
        Background="{DynamicResource Areopag.Bg0}">
    <DockPanel>
        <StatusBar DockPanel.Dock="Bottom" HorizontalContentAlignment="Stretch">
            <StatusBarItem HorizontalContentAlignment="Stretch">
                <TextBlock Text="{Binding StatusText}" FontSize="14" Margin="0 -1"/>
            </StatusBarItem>
        </StatusBar>

        <!-- Период и обновление -->
        <DockPanel DockPanel.Dock="Top" Margin="6">
            <Button DockPanel.Dock="Right" Content="Обновить" Width="110" Margin="6 0 0 0"
                    FontSize="14" Command="{Binding RefreshCommand}"/>
            <TextBlock DockPanel.Dock="Left" Text="С:" VerticalAlignment="Center" FontSize="14" Margin="0 0 4 0"
                       FontFamily="{DynamicResource Areopag.FontMono}"
                       Foreground="{DynamicResource Areopag.Text}"/>
            <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding FromDate}" Width="130"
                        FontFamily="{DynamicResource Areopag.FontMono}" FontSize="14" Margin="0 0 12 0"
                        BorderThickness="0" Style="{StaticResource DatePickerOutlineStyle}"
                        CalendarStyle="{StaticResource Areopag.CalendarStyle}"/>
            <TextBlock DockPanel.Dock="Left" Text="По:" VerticalAlignment="Center" FontSize="14" Margin="0 0 4 0"
                       FontFamily="{DynamicResource Areopag.FontMono}"
                       Foreground="{DynamicResource Areopag.Text}"/>
            <DatePicker DockPanel.Dock="Left" SelectedDate="{Binding ToDate}" Width="130"
                        FontFamily="{DynamicResource Areopag.FontMono}" FontSize="14" Margin="0 0 12 0"
                        BorderThickness="0" Style="{StaticResource DatePickerOutlineStyle}"
                        CalendarStyle="{StaticResource Areopag.CalendarStyle}"/>
            <TextBlock VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap"
                       Foreground="{DynamicResource Areopag.Text2}"
                       Text="По последнему решению на каждые сутки. Тень — решения, принятые в режиме «Тень» (в БД ничего не писалось)."/>
        </DockPanel>

        <Grid Margin="6 0 6 6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Сводные числа -->
            <ItemsControl Grid.Row="0" ItemsSource="{Binding SummaryRows}" Margin="0 0 0 8">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <!-- Подпись и значение рядом: ширина подписи фиксирована, значение слева -->
                        <Grid Margin="0 1">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="400"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="{Binding Label}" FontSize="14"
                                       Foreground="{DynamicResource Areopag.Text2}"/>
                            <TextBlock Grid.Column="1" Text="{Binding Value}" FontSize="14"
                                       FontFamily="{DynamicResource Areopag.FontMono}" TextWrapping="Wrap">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsAlert}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource Areopag.Alert}"/>
                                                <Setter Property="FontWeight" Value="SemiBold"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- Почему сутки не закрыты автоматически -->
            <DataGrid Grid.Row="1" ItemsSource="{Binding Reasons}" IsReadOnly="True" AutoGenerateColumns="False"
                      FontSize="13" BorderThickness="0 1 0 0" GridLinesVisibility="Horizontal"
                      MaxHeight="170" Margin="0 0 0 8" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Причина, по которой сутки не закрыты автоматически"
                                        Binding="{Binding Reason}" Width="*"/>
                    <DataGridTextColumn Header="Раз" Binding="{Binding Count}" Width="70"/>
                </DataGrid.Columns>
            </DataGrid>

            <!-- Выборочный контроль закрытых ИИ суток: двойной клик — открыть сутки -->
            <DataGrid x:Name="ClosedGrid" Grid.Row="2" ItemsSource="{Binding ClosedDays}"
                      IsReadOnly="True" AutoGenerateColumns="False" FontSize="13"
                      BorderThickness="0 1 0 0" GridLinesVisibility="Horizontal" HeadersVisibility="Column">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Дата" Binding="{Binding Date, StringFormat=dd.MM.yyyy}" Width="100"/>
                    <DataGridTextColumn Header="Станок" Binding="{Binding Machine}" Width="200"/>
                    <DataGridTextColumn Header="Увер." Binding="{Binding Confidence}" Width="64"/>
                    <DataGridTextColumn Header="Искл." Binding="{Binding Excluded}" Width="56"/>
                    <DataGridTextColumn Header="Контроль" Binding="{Binding ControlText}" Width="*" MinWidth="330"/>
                    <DataGridTemplateColumn Header="Закрыто ИИ — проверка" Width="330">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Согласен" Margin="0 0 4 0" Padding="8 0" FontSize="12"
                                            Command="{Binding DataContext.AgreeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Пропуск" Margin="0 0 4 0" Padding="8 0" FontSize="12"
                                            Command="{Binding DataContext.MissCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                    <Button Content="Пропуск hard" Padding="8 0" FontSize="12"
                                            Style="{StaticResource Areopag.DangerButton}"
                                            FontFamily="{DynamicResource Areopag.FontMono}"
                                            Command="{Binding DataContext.MissHardCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                            CommandParameter="{Binding}"/>
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Grid>
    </DockPanel>
</Window>
