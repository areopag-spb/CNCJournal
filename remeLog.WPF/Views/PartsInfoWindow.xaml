            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
                <Style TargetType="TextBox" BasedOn="{StaticResource TableTextBox}"/>
            </DataGridTextColumn.EditingElementStyle>
        </DataGridTextColumn>

        <DataGridTextColumn x:Key="PartNameColumn" inf:ColumnId.Id="PartName" Header="Деталь" Binding="{Binding PartName}" Width="130"
                            Visibility="{Binding DataContext.VisibleColumnIds,
                            Source={x:Reference partsInfoWindow},
                            Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=PartName}">
            <DataGridTextColumn.ElementStyle>
