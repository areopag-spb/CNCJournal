        <!-- Фоновая ИИ-проверка комментариев мастера (фича AiMasterCheck): совещательный
             статус строки, tooltip с текстом замечания. Видна только при включённой фиче. -->
        <DataGridTemplateColumn x:Key="AiCheckColumn" inf:ColumnId.Id="AiCheck" Header="ИИ" Width="24" IsReadOnly="True">
            <DataGridTemplateColumn.Visibility>
                <MultiBinding Converter="{StaticResource AllVisibleMultiConverter}">
                    <Binding Path="DataContext.HasFeatureAiMasterCheck" Source="{x:Reference partsInfoWindow}" Converter="{StaticResource VisibilityConverter}"/>
                    <Binding Path="DataContext.VisibleColumnIds" Source="{x:Reference partsInfoWindow}" Converter="{StaticResource ColumnVisibilityConverter}" ConverterParameter="AiCheck"/>
                </MultiBinding>
            </DataGridTemplateColumn.Visibility>
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <!-- Tooltip на растянутом Grid с Background=Transparent: без фона hit-test
                         работает только на пикселях символа — в узкие «✓»/«!» курсором не попасть. -->
                    <Grid Background="Transparent">
                        <Grid.Style>
                            <Style TargetType="Grid">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding AiCheckStatus}" Value="Ok">
                                        <Setter Property="ToolTip" Value="ИИ: комментарии релевантны"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AiCheckStatus}" Value="Remark">
                                        <Setter Property="ToolTip" Value="{Binding AiCheckRemark}"/>
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding AiCheckStatus}" Value="Error">
                                        <Setter Property="ToolTip" Value="{Binding AiCheckRemark}"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Grid.Style>
                        <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource TableTextBlock}">
                                    <Setter Property="Text" Value=""/>
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding AiCheckStatus}" Value="Ok">
                                            <Setter Property="Text" Value="✓"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Areopag.Ok}"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AiCheckStatus}" Value="Remark">
                                            <Setter Property="Text" Value="!"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Areopag.Warn}"/>
                                            <Setter Property="FontWeight" Value="Bold"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding AiCheckStatus}" Value="Error">
                                            <Setter Property="Text" Value="?"/>
                                            <Setter Property="Foreground" Value="{DynamicResource Areopag.Text3}"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                        <Viewbox x:Name="AiCheckSpinner" Width="12" Height="12"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Visibility="Collapsed" ToolTip="ИИ проверяет комментарии…">
                            <Canvas Width="80" Height="80" Background="Transparent">
                                <Canvas.RenderTransform>
                                    <RotateTransform x:Name="AiCheckSpinnerRotate" CenterX="40" CenterY="40"/>
                                </Canvas.RenderTransform>
                                <Path Stroke="{DynamicResource Areopag.Text3}" StrokeThickness="8"
                                      Data="M 40,10 A 30,30 0 0 1 70,40"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                                <Path Stroke="{DynamicResource Areopag.Text3}" StrokeThickness="8"
                                      Data="M 40,70 A 30,30 0 0 1 10,40"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"/>
                            </Canvas>
                        </Viewbox>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding AiCheckStatus}" Value="Pending">
                            <Setter TargetName="AiCheckSpinner" Property="Visibility" Value="Visible"/>
                            <DataTrigger.EnterActions>
                                <BeginStoryboard x:Name="AiCheckSpinnerStoryboard">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation Storyboard.TargetName="AiCheckSpinnerRotate"
                                                         Storyboard.TargetProperty="Angle"
                                                         From="0" To="360"
                                                         Duration="0:0:1"/>
                                    </Storyboard>
                                </BeginStoryboard>
                            </DataTrigger.EnterActions>
                            <DataTrigger.ExitActions>
                                <StopStoryboard BeginStoryboardName="AiCheckSpinnerStoryboard"/>
                            </DataTrigger.ExitActions>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
        </DataGridTemplateColumn>

