<Window x:Class="remeLog.Views.PartsInfoWindow" chrome:WindowChromeTheme.Enabled="True" x:Name="partsInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
         xmlns:chrome="clr-namespace:libeLog.Infrastructure;assembly=libeLog"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        xmlns:local="clr-namespace:remeLog.Views" 
        xmlns:controls="clr-namespace:remeLog.Views.Controls"
        xmlns:inf="clr-namespace:remeLog.Infrastructure" 
        xmlns:cnv="clr-namespace:remeLog.Infrastructure.Converters"
        xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
        xmlns:cnt="clr-namespace:remeLog.Views.Controls"
        xmlns:vm="clr-namespace:remeLog.ViewModels"
        xmlns:md="clr-namespace:remeLog.Models;assembly=remeLog.Core"
        mc:Ignorable="d" 
        d:DataContext="{d:DesignInstance Type=vm:PartsInfoWindowViewModel}"
        Title="{Binding PartsInfo.Machine}" Height="800" Width="1700" 
        WindowStartupLocation="CenterOwner" 
        WindowState="Maximized" 
        PreviewKeyDown="PartsInfoWindow_PreviewKeyDown"
        Background="{DynamicResource Areopag.Bg0}">
    <Window.InputBindings>
        <KeyBinding Modifiers="Ctrl" Key="S" Command="{Binding UpdatePartsCommand}"/>
    </Window.InputBindings>
    <Window.Resources>
        <ContextMenu x:Key="GenericCellFilterContextMenu"/>
        <Style TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Foreground" Value="{DynamicResource Areopag.Text}"/>
        </Style>
        <!-- Цвета/каретка/disabled — из базового Areopag.TextBox; здесь только кнопка очистки -->
        <Style TargetType="TextBox" x:Key="ClearableTextBox" BasedOn="{StaticResource Areopag.TextBox}">            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Grid>
                            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="0">
                                <Grid>
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="false" HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Hidden"/>
                                    <Button x:Name="ClearButton" HorizontalAlignment="Right" Background="Transparent" BorderThickness="0"
                                            VerticalAlignment="Center" Width="20" Height="20" Margin="0 0 0 0"
                                            Command="{Binding ClearContentCommand}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType={x:Type TextBox}}}">
                                        <Button.Content>
                                            <StaticResource ResourceKey="CleanData"/>
                                        </Button.Content>
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="Text" Value=""/>
                                </MultiTrigger.Conditions>
                                <Setter TargetName="ClearButton" Property="Visibility" Value="Collapsed"/>
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Подсказка пустых полей и «кнопка-комбобокс» фильтра — общие
             стили в ImplicitStyles (Areopag.FieldHint / Areopag.MachineFilterToggle).
             Редактор комментариев с орфографией — тоже там:
             Areopag.TableLargeTextBox.SpellChecked. -->

        <ControlTemplate x:Key="ValidationTemplate">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0" Text="!" FontSize="24" Foreground="{DynamicResource Areopag.Alert}" Margin="0 -8 -8 0" MouseLeftButtonUp="ValidationTextBlock_MouseLeftButtonUp"/>
                <AdornedElementPlaceholder Grid.Column="1"/>
            </Grid>
        </ControlTemplate>
        <ControlTemplate x:Key="ValidationEditingTemplate">
            <Border BorderBrush="{DynamicResource Areopag.Alert}" BorderThickness="1">
                <AdornedElementPlaceholder/>
            </Border>
        </ControlTemplate>
        
        <!--#region Столбцы -->
        <DataGridTextColumn x:Key="MachineColumn" inf:ColumnId.Id="Machine" Header="Станок" Binding="{Binding Machine}"
                            Width="85" IsReadOnly="True">
            <DataGridTextColumn.Visibility>
                <MultiBinding Converter="{StaticResource AllVisibleMultiConverter}">
                    <Binding Path="DataContext.MachineVisibility" Source="{x:Reference partsInfoWindow}" Converter="{StaticResource InvertedVisibilityConverter}"/>
                    <Binding Path="DataContext.VisibleColumnIds" Source="{x:Reference partsInfoWindow}" Converter="{StaticResource ColumnVisibilityConverter}" ConverterParameter="Machine"/>
                </MultiBinding>
            </DataGridTextColumn.Visibility>
            <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TableTextBlock}"/>
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
                <Style TargetType="TextBox" BasedOn="{StaticResource TableTextBox}"/>
            </DataGridTextColumn.EditingElementStyle>
        </DataGridTextColumn>

        <DataGridTextColumn x:Key="ShiftDateColumn" inf:ColumnId.Id="ShiftDate" Header="Дата" Binding="{Binding ShiftDate, StringFormat=dd.MM.yy, Converter={StaticResource ShortDateConverter}}" Width="50"
                            Visibility="{Binding DataContext.VisibleColumnIds,
                            Source={x:Reference partsInfoWindow},
                            Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=ShiftDate}">
            <DataGridTextColumn.ElementStyle>
                <Style TargetType="TextBlock" BasedOn="{StaticResource TableTextBlock}"/>
            </DataGridTextColumn.ElementStyle>
            <DataGridTextColumn.EditingElementStyle>
                <Style TargetType="TextBox" BasedOn="{StaticResource TableTextBox}"/>
            </DataGridTextColumn.EditingElementStyle>
        </DataGridTextColumn>

        <DataGridTemplateColumn x:Key="ShiftColumn" inf:ColumnId.Id="Shift" Header="Смена" Width="35"
                                Visibility="{Binding DataContext.VisibleColumnIds,
                                Source={x:Reference partsInfoWindow},
                                Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Shift}">
            <DataGridTemplateColumn.CellTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Shift}" Style="{StaticResource TableTextBlock}"/>
                </DataTemplate>
            </DataGridTemplateColumn.CellTemplate>
            <DataGridTemplateColumn.CellEditingTemplate>
                <DataTemplate>
                    <ComboBox ItemsSource="{x:Static inf:AppSettings.ShiftTypes}" 
              SelectedItem="{Binding Shift}" Style="{StaticResource TableComboBox}"/>
                </DataTemplate>
            </DataGridTemplateColumn.CellEditingTemplate>
        </DataGridTemplateColumn>

        <DataGridTextColumn x:Key="OperatorColumn" inf:ColumnId.Id="Operator" Header="Оператор" Binding="{Binding Operator}" Width="95"
                            Visibility="{Binding DataContext.VisibleColumnIds,
                            Source={x:Reference partsInfoWindow},
                            Converter={StaticResource ColumnVisibilityConverter}, ConverterParameter=Operator}">
